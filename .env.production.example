# ==============================================================================
# Hapini - AWS Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets or production credentials to source control.
# - In AWS, store these values in AWS Systems Manager (SSM) Parameter Store or
#   AWS Secrets Manager and inject them at runtime via ECS / App Runner.
# ==============================================================================

# Node Runtime
NODE_ENV=production
PORT=5000

# Client Origins for CORS (comma-separated if multiple domains)
# Example: https://hapini.com,https://www.hapini.com,https://d12345abcdef.cloudfront.net
CLIENT_URL=https://your-cloudfront-distribution-or-domain.net

# Database - Amazon RDS PostgreSQL 16
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>
DATABASE_URL=postgresql://hapini_admin:REPLACE_WITH_RDS_PASSWORD@hapini-db.cxxxxxx.us-east-1.rds.amazonaws.com:5432/hapini_prod
DB_HOST=hapini-db.cxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=hapini_prod
DB_USER=hapini_admin
DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD
DB_SSL=true

# Cache - Amazon ElastiCache (Redis / Valkey)
# For cost-optimization, leave empty or unset to use the built-in high-performance
# in-memory cache fallback ($0/month). For high-scale multi-instance production:
REDIS_URL=redis://hapini-cache.xxxxxx.0001.use1.cache.amazonaws.com:6379
REDIS_HOST=hapini-cache.xxxxxx.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=120
PRODUCT_CACHE_TTL_SECONDS=600

# Security & Authentication (Generate using: openssl rand -base64 48)
# Must be at least 32 characters in production.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=info
