# ===================================================
# Hapini — Smart Price Comparison Platform
# Environment Configuration Template (Placeholders only)
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=hapini_dev
TEST_DB_NAME=hapini_test
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/hapini_dev
TEST_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/hapini_test

# Redis Cache Configuration (Optional caching layer with transparent memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=120
PRODUCT_CACHE_TTL_SECONDS=600

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:5000/api
