{
  "name": "hapini",
  "version": "1.0.0",
  "description": "Hapini — Smart Price Comparison Platform",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend test",
    "test:unit": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "test:auth": "npm --prefix backend run test:auth",
    "test:cache": "npm --prefix backend run test:cache",
    "test:alerts": "npm --prefix backend run test:alerts",
    "test:persistence": "npm --prefix backend run test:persistence",
    "build": "npm run build:frontend && npm run build:backend",
    "db:create": "npm --prefix backend run db:create",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup"
  },
  "dependencies": {
    "recharts": "^3.8.1"
  }
}
